{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Node", // 兼容 vue-tsc 解析，避免 bundler 模式冲突
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"] // 与 Vite 别名一致，避免路径错误
    },
    "allowJs": true,
    "esModuleInterop": true,
    "types": ["vue", "node"] // 关键：添加 Vue 和 Node 类型支持，修复类型缺失
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/shims-vue.d.ts" // 包含 Vue 类型声明文件（需新增该文件）
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}